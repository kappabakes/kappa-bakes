# Database (Vercel Postgres / Neon / Supabase — any Postgres URL)
DATABASE_URL="postgres://..."

# Stripe — test keys start sk_test_ / pk_test_
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend — free tier covers 3,000/month)
RESEND_API_KEY="re_..."
FROM_EMAIL="orders@kappabakes.com"

# SMS (The SMS Works). Leave blank to skip SMS entirely.
SMS_API_KEY=""
SMS_SENDER_ID="KappaBakes"

# The admin lives here instead of /admin, which returns 404. Make it
# unguessable — letters, numbers and dashes only. Leave blank in local
# development to keep /admin working.
ADMIN_PATH="kb-9f42-portal"

# Only for testing a production build over your local network (a phone
# hitting your Mac's IP over plain HTTP). Leave unset on Vercel.
ALLOW_INSECURE_COOKIE="false"

# Admin sign-in
ADMIN_PASSWORD="change-me"
# Emails allowed to sign in. ORDER MATTERS — the first is where codes go by
# default, the second is the "use another address" fallback.
ADMIN_EMAILS="kappabakes@gmail.com,sufyaankapde357@gmail.com"
# Long random string — signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-too"

# Passkeys (Face ID / Touch ID). RP_ID is the bare domain, no scheme or port.
# Locally use RP_ID="localhost" and RP_ORIGIN="http://localhost:3000"
RP_ID="kappabakes.com"
RP_ORIGIN="https://kappabakes.com"

# Test tools in /admin: create orders without paying, and delete them.
# MUST be "false" (or removed) in production.
TEST_MODE="true"

# Menu photo uploads. Create a Blob store in the Vercel dashboard and it adds
# this for you. Without it you can still type a path to a file in /public.
BLOB_READ_WRITE_TOKEN=""

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL="https://kappabakes.com"

# Secret for the scheduled low-stock email (any long random string)
CRON_SECRET="change-me-too"
